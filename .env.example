# ============================================================
# AlgoSolver LLM 配置模板（多模型 + 能力降级）
# 复制本文件为 .env 并填写真实值：
#   cp .env.example .env
# ============================================================
# 降级策略：从"能力最强"的模型开始尝试；某模型失败后本次不再使用，
# 自动切换下一个较弱的模型。
# 推荐顺序：GLM-4.7 > GLM-4.6V > GLM-4.5-Air > deepseek-r1:8b > qwen3.5:4b

# ---- 云端）智谱 GLM（OpenAI 兼容，能力最强）----
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=your-glm-api-key
GLM_MODELS=GLM-4.7,GLM-4.6V,GLM-4.5-Air

# ---- 本地 Ollama（能力较弱，最终兜底）----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELS=deepseek-r1:8b,qwen3.5:4b

# ---- 遗留配置（可选）：仅当上方均未配置时用于单一模型 ----
# LLM_BASE_URL=http://10.0.131.251:9005/v1
# LLM_API_KEY=
# LLM_MODEL=